# Stage 1: build.
FROM node:22-alpine AS build

WORKDIR /app

# copy package manifests first for layer caching (same reason as the backend)
COPY frontend/package*.json ./
RUN npm ci

# copy source and build for production (tree-shaking, minification, AOT)
COPY frontend/ .
RUN npm run build -- --configuration production

# Stage 2: serve with nginx.
# nginx serves the static files and also proxies /api/ to the backend container,
# so the frontend never needs to know the backend URL.
FROM nginx:alpine

# replace the default nginx config with ours
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Generate a self-signed TLS certificate at build time so `docker compose up` serves
# HTTPS with no manual keytool/openssl steps. localhost + 127.0.0.1 SAN so browsers
# accept it after the one-time "untrusted certificate" prompt. For production, swap in
# a CA-signed cert by mounting it over /etc/nginx/certs (see README).
RUN apk add --no-cache openssl && \
    mkdir -p /etc/nginx/certs && \
    openssl req -x509 -nodes -newkey rsa:2048 -days 365 \
      -keyout /etc/nginx/certs/server.key \
      -out    /etc/nginx/certs/server.crt \
      -subj   "/CN=localhost/O=UoA/OU=TED/C=GR" \
      -addext "subjectAltName=DNS:localhost,IP:127.0.0.1"

# @angular/build:application outputs browser files to dist/<project-name>/browser/;
# adjust this path if the project name changes.
COPY --from=build /app/dist/frontend/browser /usr/share/nginx/html

EXPOSE 80 443
